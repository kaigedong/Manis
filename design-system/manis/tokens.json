{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Manis Design System — Obsidian & Alabaster (Swiss Precision Routing). Unified cross-platform tokens for Desktop (Rust GPUI) and Mobile (Android Jetpack Compose).",
  "meta": {
    "system": "Manis UI 2.0",
    "northStar": "Obsidian & Alabaster — Swiss Precision Routing",
    "version": "2.0.0",
    "platforms": ["desktop-gpui", "android-compose"]
  },
  "color": {
    "light": {
      "surface": {
        "canvas": { "$value": "#F7F6F3", "$type": "color", "$description": "Primary warm alabaster workspace canvas" },
        "chrome": { "$value": "#EFECE6", "$type": "color", "$description": "Navigation rail, app bar, bottom bar, subtle chrome" },
        "low": { "$value": "#F1EFEA", "$type": "color", "$description": "Recessed containers, input wells, segmented tracks" },
        "elevated": { "$value": "#FFFFFF", "$type": "color", "$description": "Cards, list containers, primary content panes" },
        "high": { "$value": "#E6E3DC", "$type": "color", "$description": "Hover fills, subtle pressed surfaces" },
        "overlay": { "$value": "#FFFFFF", "$type": "color", "$description": "Popovers, dialogs, bottom sheets, utility editors" }
      },
      "text": {
        "primary": { "$value": "#141413", "$type": "color", "$description": "Carbon ink headings & body (>=16:1 on elevated)" },
        "secondary": { "$value": "#4E4D49", "$type": "color", "$description": "Supporting descriptions & labels (>=7.4:1 on elevated)" },
        "tertiary": { "$value": "#5E5C57", "$type": "color", "$description": "Metadata, timestamps, placeholders (>=5.5:1 on low)" }
      },
      "border": {
        "subtle": { "$value": "#E5E2DC", "$type": "color", "$description": "Card outlines, hairline dividers" },
        "strong": { "$value": "#8B8881", "$type": "color", "$description": "Interactive input boundaries (>=3.2:1 on elevated)" }
      },
      "accent": {
        "primary": { "$value": "#2B4EFF", "$type": "color", "$description": "Electric Indigo-Cobalt primary actions & active selection" },
        "primaryHover": { "$value": "#1F3EE0", "$type": "color" },
        "primaryActive": { "$value": "#1732BD", "$type": "color" },
        "onPrimary": { "$value": "#FFFFFF", "$type": "color", "$description": ">=5.6:1 on primary" },
        "soft": { "$value": "#EEF2FF", "$type": "color", "$description": "Selected row tint, active pill surface" },
        "focusRing": { "$value": "#2B4EFF", "$type": "color", "$description": "2px visible keyboard focus outline" }
      },
      "control": {
        "secondaryBg": { "$value": "#F4F3EF", "$type": "color" },
        "secondaryHover": { "$value": "#EAE7E0", "$type": "color" },
        "secondaryActive": { "$value": "#DFDCD3", "$type": "color" }
      },
      "route": {
        "trace": { "$value": "#6D28D9", "$type": "color", "$description": "Royal Violet reserved exclusively for rule->group->node chain" },
        "soft": { "$value": "#F3EEFF", "$type": "color" }
      },
      "semantic": {
        "success": { "$value": "#0E7A4B", "$type": "color", "$description": "Connected tunnel, low latency (<120ms)" },
        "successSoft": { "$value": "#E8F7F0", "$type": "color" },
        "warning": { "$value": "#9A5504", "$type": "color", "$description": "Medium latency (120-350ms), pending changes" },
        "warningSoft": { "$value": "#FEF5E7", "$type": "color" },
        "error": { "$value": "#C81E1E", "$type": "color", "$description": "Errors, timeout, high latency (>350ms)" },
        "errorSoft": { "$value": "#FEF2F2", "$type": "color" },
        "dangerFill": { "$value": "#C81E1E", "$type": "color" },
        "dangerHover": { "$value": "#A61717", "$type": "color" },
        "dangerActive": { "$value": "#861212", "$type": "color" },
        "onDanger": { "$value": "#FFFFFF", "$type": "color" }
      },
      "log": {
        "info": { "$value": "#1D4ED8", "$type": "color" },
        "debug": { "$value": "#6D28D9", "$type": "color" },
        "trace": { "$value": "#0F766E", "$type": "color" }
      },
      "scrim": { "$value": "#14141359", "$type": "color" }
    },
    "dark": {
      "surface": {
        "canvas": { "$value": "#0D0D0F", "$type": "color", "$description": "True obsidian OLED canvas" },
        "chrome": { "$value": "#141417", "$type": "color", "$description": "Navigation rail, app bar, bottom bar" },
        "low": { "$value": "#17171B", "$type": "color", "$description": "Recessed input wells, segmented tracks" },
        "elevated": { "$value": "#1C1C21", "$type": "color", "$description": "Cards, list containers, primary panes" },
        "high": { "$value": "#25252C", "$type": "color", "$description": "Hover states, active subtle fills" },
        "overlay": { "$value": "#212127", "$type": "color", "$description": "Popovers, dialogs, sheets, utility windows" }
      },
      "text": {
        "primary": { "$value": "#F4F4F6", "$type": "color", "$description": "Crisp chalk white (>=15.8:1 on elevated)" },
        "secondary": { "$value": "#B4B4BE", "$type": "color", "$description": "Secondary descriptions (>=7.9:1 on elevated)" },
        "tertiary": { "$value": "#9A9AA6", "$type": "color", "$description": "Metadata & timestamps (>=5.5:1 on high)" }
      },
      "border": {
        "subtle": { "$value": "#2B2B33", "$type": "color" },
        "strong": { "$value": "#787886", "$type": "color", "$description": ">=3.5:1 on elevated" }
      },
      "accent": {
        "primary": { "$value": "#6B8AFF", "$type": "color", "$description": "Luminous Cobalt primary in dark mode" },
        "primaryHover": { "$value": "#859FFF", "$type": "color" },
        "primaryActive": { "$value": "#A1B5FF", "$type": "color" },
        "onPrimary": { "$value": "#0A0D18", "$type": "color", "$description": ">=6.8:1 on primary" },
        "soft": { "$value": "#1B2342", "$type": "color", "$description": "Selected row tint, active pill surface" },
        "focusRing": { "$value": "#859FFF", "$type": "color" }
      },
      "control": {
        "secondaryBg": { "$value": "#24242C", "$type": "color" },
        "secondaryHover": { "$value": "#2E2E38", "$type": "color" },
        "secondaryActive": { "$value": "#383844", "$type": "color" }
      },
      "route": {
        "trace": { "$value": "#C4B5FD", "$type": "color", "$description": "Luminous Lavender-Violet for route chain" },
        "soft": { "$value": "#271F3D", "$type": "color" }
      },
      "semantic": {
        "success": { "$value": "#4ADE80", "$type": "color" },
        "successSoft": { "$value": "#122B20", "$type": "color" },
        "warning": { "$value": "#FBBF24", "$type": "color" },
        "warningSoft": { "$value": "#2E2312", "$type": "color" },
        "error": { "$value": "#F87171", "$type": "color" },
        "errorSoft": { "$value": "#331719", "$type": "color" },
        "dangerFill": { "$value": "#C81E1E", "$type": "color" },
        "dangerHover": { "$value": "#A61717", "$type": "color" },
        "dangerActive": { "$value": "#861212", "$type": "color" },
        "onDanger": { "$value": "#FFFFFF", "$type": "color" }
      },
      "log": {
        "info": { "$value": "#93C5FD", "$type": "color" },
        "debug": { "$value": "#D8B4FE", "$type": "color" },
        "trace": { "$value": "#5EEAD4", "$type": "color" }
      },
      "scrim": { "$value": "#00000080", "$type": "color" }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": { "$value": "'Inter', -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'PingFang SC', 'Noto Sans SC', 'Segoe UI', sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "'JetBrains Mono', 'SF Mono', 'Roboto Mono', ui-monospace, monospace", "$type": "fontFamily" }
    },
    "scale": {
      "pageTitle": { "desktop": "22px/30px/600/-0.02em", "mobile": "24px/32px/600/-0.02em" },
      "sectionTitle": { "desktop": "15px/22px/600/-0.01em", "mobile": "16px/22px/600/-0.01em" },
      "body": { "desktop": "13.5px/20px/400/0", "mobile": "14.5px/21px/400/0" },
      "label": { "desktop": "13px/18px/500/0", "mobile": "14px/20px/500/0" },
      "monoData": { "desktop": "12px/18px/500/0", "mobile": "13px/18px/500/0" },
      "meta": { "desktop": "11.5px/16px/400/0", "mobile": "12px/16px/400/0" }
    }
  },
  "spacing": {
    "xs": { "$value": "4px", "$type": "dimension" },
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "12px", "$type": "dimension" },
    "lg": { "$value": "16px", "$type": "dimension" },
    "xl": { "$value": "24px", "$type": "dimension" },
    "2xl": { "$value": "32px", "$type": "dimension" }
  },
  "radius": {
    "badge": { "$value": "5px", "$type": "dimension" },
    "control": { "$value": "7px", "$type": "dimension" },
    "row": { "$value": "8px", "$type": "dimension" },
    "card": { "$value": "12px", "$type": "dimension" },
    "sheet": { "$value": "16px", "$type": "dimension" },
    "pill": { "$value": "9999px", "$type": "dimension" }
  },
  "motion": {
    "fast": { "$value": "140ms cubic-bezier(0.2, 0, 0, 1)", "$type": "string", "$description": "Hover, press, toggle state shifts" },
    "standard": { "$value": "220ms cubic-bezier(0.16, 1, 0.3, 1)", "$type": "string", "$description": "Expand/collapse, segmented thumb, route tab transition" },
    "sheet": { "$value": "280ms cubic-bezier(0.16, 1, 0.3, 1)", "$type": "string", "$description": "Bottom sheet & modal entrance (exit 180ms)" }
  }
}
