{
  "name": "Manis NSH UI",
  "id": "dev.manis.app.nsh",
  "version": "0.1.0",
  "build": 1,
  "capabilities": {
    "clipboard": true,
    "host": [
      "nodes.refresh",
      "nodes.select",
      "nodes.selectGroup",
      "subscriptions.toggle",
      "subscriptions.delete",
      "subscriptions.add",
      "subscriptions.addNode",
      "subscriptions.addGroup",
      "subscriptions.refresh",
      "subscriptions.apply",
      "rules.toggle",
      "rules.delete",
      "rules.save",
      "rules.apply",
      "settings.reload",
    "settings.autostart.set",
      "settings.logs",
      "settings.copyBackup",
      "settings.importBackup",
      "settings.dns.set",
      "settings.update.check",
      "settings.update.download",
      "settings.update.install",
      "settings.update.release",
      "connection.toggle",
      "connection.mode",
      "connection.reload",
      "workspace.apply",
      "workspace.discard"
    ]
  }
}
