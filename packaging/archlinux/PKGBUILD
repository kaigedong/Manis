# Maintainer: Manis contributors <https://github.com/kaigedong/Manis>

pkgname=manis
pkgver="$($startdir/../package-version.sh)"
pkgrel=1
pkgdesc="NSH desktop workbench for policy-based proxy routing"
arch=('x86_64')
url="https://github.com/kaigedong/Manis"
license=('Apache-2.0' 'GPL-3.0-only')
depends=(
  'gtk4'
  'hicolor-icon-theme'
  'libcap'
  'libx11'
  'libxcb'
  'libxkbcommon'
  'libxkbcommon-x11'
  'polkit'
  'wayland'
)
makedepends=('cargo' 'clang' 'cmake' 'desktop-file-utils' 'git' 'pkgconf' 'rust')
options=('!debug')
install=manis.install
source=()
sha256sums=()

build() {
  cd "$startdir/../.."
  local rust_flags="${RUSTFLAGS:+$RUSTFLAGS }-C linker-features=-lld"
  local target_dir="$startdir/../../target/archlinux"

  # A restored cache can keep ring's rlib without the C archive its build
  # script produced, which fails the link with undefined ring_core_* symbols.
  CARGO_TARGET_DIR="$target_dir" cargo clean -p ring --release || true

  # The headless engine owns the Mihomo process and the saved profile.
  RUSTFLAGS="$rust_flags" \
    CARGO_TARGET_DIR="$target_dir" \
    cargo build -p manis-service --release --locked

  # Use a separate target dir: a restored Cargo cache can keep a stale
  # quickjs-jit-macro artifact that makes quickjs-jit fail with
  # "can't find crate for rquickjs_macro".
  local nsh_target="$startdir/../../target/archlinux-nsh"
  RUSTFLAGS="$rust_flags" \
    CARGO_TARGET_DIR="$nsh_target" \
    cargo build -p manis-nsh-desktop --release --locked

  RUSTFLAGS="$rust_flags" \
    CARGO_TARGET_DIR="$target_dir" \
    cargo build -p manis-linux-helper --release --locked

  if [[ -n "${MANIS_MIHOMO_BINARY:-}" ]]; then
    if [[ ! -x "$MANIS_MIHOMO_BINARY" ]]; then
      error "MANIS_MIHOMO_BINARY must point to an executable Mihomo binary"
      return 1
    fi
    install -Dm755 "$MANIS_MIHOMO_BINARY" "$target_dir/release/mihomo"
  else
    MANIS_MIHOMO_OS=Linux MANIS_MIHOMO_ARCH=x86_64 \
      "$startdir/../fetch-mihomo.sh" "$target_dir/release/mihomo"
  fi
}

check() {
  desktop-file-validate "$startdir/dev.manis.app.desktop"
}

package() {
  install -Dm755 "$startdir/../../target/archlinux-nsh/release/manis-nsh-desktop" \
    "$pkgdir/usr/bin/manis"
  install -Dm755 "$startdir/../../target/archlinux/release/manis-engine" \
    "$pkgdir/usr/bin/manis-engine"
  install -Dm755 "$startdir/../../target/archlinux/release/mihomo" \
    "$pkgdir/usr/lib/manis/mihomo"
  install -Dm755 "$startdir/../../target/archlinux/release/manis-linux-helper" \
    "$pkgdir/usr/lib/manis/manis-linux-helper"
  install -Dm644 "$startdir/dev.manis.app.linux-helper.policy" \
    "$pkgdir/usr/share/polkit-1/actions/dev.manis.app.linux-helper.policy"
  install -Dm644 "$startdir/dev.manis.app.desktop" \
    "$pkgdir/usr/share/applications/dev.manis.app.desktop"
  install -Dm644 "$startdir/../../assets/brand/manis-mark.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.manis.app.svg"
  install -Dm644 "$startdir/../../LICENSE" "$pkgdir/usr/share/licenses/manis/LICENSE"
  ln -s /usr/share/licenses/common/GPL3/license.txt \
    "$pkgdir/usr/share/licenses/manis/Mihomo-GPL-3.0.txt"
  install -Dm644 "$startdir/../../THIRD_PARTY_NOTICES.md" \
    "$pkgdir/usr/share/doc/manis/THIRD_PARTY_NOTICES.md"
}
