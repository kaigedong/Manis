# Maintainer: Manis contributors <https://github.com/kaigedong/Manis>

pkgname=manis
pkgver="$($startdir/../package-version.sh)"
pkgrel=1
pkgdesc="GPUI desktop workbench for policy-based proxy routing"
arch=('x86_64')
url="https://github.com/kaigedong/Manis"
license=('Apache-2.0')
depends=(
  'alsa-lib'
  'fontconfig'
  'gtk3'
  'hicolor-icon-theme'
  'libappindicator'
  'libx11'
  'libxcb'
  'libxkbcommon'
  'libxkbcommon-x11'
  'vulkan-icd-loader'
  'wayland'
  'xdotool'
)
makedepends=('cargo' 'clang' 'cmake' 'desktop-file-utils' 'git' 'pkgconf' 'rust')
options=('!debug')
source=()
sha256sums=()

build() {
  cd "$startdir/../.."
  local rust_flags="${RUSTFLAGS:+$RUSTFLAGS }-C linker-features=-lld"
  local target_dir="$startdir/../../target/archlinux"

  RUSTFLAGS="$rust_flags" \
    CARGO_TARGET_DIR="$target_dir" \
    cargo build -p manis-ui --lib --release --locked

  local ring_archive
  ring_archive="$(find "$target_dir/release/build" \
    -path '*/ring-*/out/libring_core_*.a' ! -name '*_test.a' -print -quit)"
  if [[ -z "$ring_archive" ]]; then
    error "ring native archive was not produced"
    return 1
  fi

  local ring_directory="${ring_archive%/*}"
  local ring_library="${ring_archive##*/lib}"
  ring_library="${ring_library%.a}"

  # Rust 1.98 does not propagate ring's bundled native archive to this Linux
  # binary, so pass the already-built archive to the final target explicitly.
  RUSTFLAGS="$rust_flags" \
    CARGO_TARGET_DIR="$target_dir" \
    cargo rustc -p manis-ui --bin manis-ui --release --locked -- \
      -L "native=$ring_directory" -l "static:+whole-archive=$ring_library"
}

check() {
  desktop-file-validate "$startdir/dev.manis.app.desktop"
}

package() {
  install -Dm755 "$startdir/../../target/archlinux/release/manis-ui" \
    "$pkgdir/usr/bin/manis"
  install -Dm644 "$startdir/dev.manis.app.desktop" \
    "$pkgdir/usr/share/applications/dev.manis.app.desktop"
  install -Dm644 "$startdir/dev.manis.app.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.manis.app.svg"
  install -Dm644 "$startdir/../../LICENSE" "$pkgdir/usr/share/licenses/manis/LICENSE"
  install -Dm644 "$startdir/../../THIRD_PARTY_NOTICES.md" \
    "$pkgdir/usr/share/doc/manis/THIRD_PARTY_NOTICES.md"
}
